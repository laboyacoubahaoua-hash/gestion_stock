II.4.3 — Exercices sur la structure répétitive conditionnelle
1. Pair/impair jusqu'à saisie de 0
#include <stdio.h>
main()
{
    int X;
    printf("\nEntrer X (0 pour arreter) : ");
    scanf("%d", &X);
    while (X != 0)
    {
        if (X % 2 == 0)
            printf("\n%d est pair", X);
        else
            printf("\n%d est impair", X);
        printf("\nEntrer X (0 pour arreter) : ");
        scanf("%d", &X);
    }
}
2. Intervalle [BI, BS]
#include <stdio.h>
main()
{
    int BI, BS, N;
    do
    {
        printf("\nEntrer BI et BS (BI < BS) : ");
        scanf("%d %d", &BI, &BS);
    } while (BI >= BS);
 
    printf("\nEntrer N (dans [%d, %d] pour quitter) : ", BI, BS);
    scanf("%d", &N);
    while (N < BI || N > BS)
    {
        if (N > BS)
            printf("\n%d est hors borne superieure", N);
        else
            printf("\n%d est en deca de la borne inferieure", N);
        printf("\nEntrer N (dans [%d, %d] pour quitter) : ", BI, BS);
        scanf("%d", &N);
    }
    printf("\nN = %d est dans l'intervalle, fin du programme", N);
}
