6. Moyenne simple répétée N fois, sans stockage, avec admissibilité
#include <stdio.h>
main()
{
    int N, i, j, nbNotes;
    float note, somme, moyenne;
 
    printf("\nEntrer N (nombre de series) : ");
    scanf("%d", &N);
 
    for (i = 1; i <= N; i++)
    {
        printf("\nEntrer le nombre de notes de la serie %d : ", i);
        scanf("%d", &nbNotes);
 
        somme = 0;
        for (j = 1; j <= nbNotes; j++)
        {
            printf("\nEntrer la note %d : ", j);
            scanf("%f", &note);
            somme = somme + note;
        }
 
        moyenne = somme / nbNotes;
        printf("\nMoyenne de la serie %d = %f", i, moyenne);
 
        if (moyenne >= 10)
            printf(" -> Admissible");
        else
            printf(" -> Non admissible");
    }
}
7. Table de multiplication répétée tant que N ≠ 0
