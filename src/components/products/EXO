II.3.3 — Exercices sur la structure répétitive avec compteur ("for")
1. Factoriel d'un nombre
#include <stdio.h>
main()
{
    int n, i;
    long fact = 1;
    printf("\nEntrer un entier : ");
    scanf("%d", &n);
    for (i = 1; i <= n; i++)
        fact = fact * i;
    printf("\nFactoriel de %d = %ld", n, fact);
}
2. X à la puissance Y
#include <stdio.h>
main()
{
    int x, y, i;
    long resultat = 1;
    printf("\nEntrer X et Y : ");
    scanf("%d %d", &x, &y);
    for (i = 1; i <= y; i++)
        resultat = resultat * x;
    printf("\n%d puissance %d = %ld", x, y, resultat);
}
II.4.2 — Exercices sur la structure répétitive conditionnelle ("while")
3. Moyenne simple de 20 notes, sans stockage des notes
#include <stdio.h>
main()
{
    int i = 1;
    float note, somme = 0, moyenne;
    while (i <= 20)
    {
        printf("\nEntrer la note %d : ", i);
        scanf("%f", &note);
        somme = somme + note;
        i++;
    }
    moyenne = somme / 20;
    printf("\nLa moyenne est : %f", moyenne);
}
4. Moyenne pondérée de 10 notes, sans stockage des notes
#include <stdio.h>
main()
{
    int i = 1;
    float note, coef, sommeNotes = 0, sommeCoef = 0, moyenne;
    while (i <= 10)
    {
        printf("\nEntrer la note %d et son coefficient : ", i);
        scanf("%f %f", &note, &coef);
        sommeNotes = sommeNotes + (note * coef);
        sommeCoef = sommeCoef + coef;
        i++;
    }
    moyenne = sommeNotes / sommeCoef;
    printf("\nLa moyenne ponderee est : %f", moyenne);
}
