II.5 — Exercices sur l'imbrication des structures de contrôle
1. Caractères hexadécimaux X1, X2 (un octet) jusqu'à "00"
#include <stdio.h>
main()
{
    char X1, X2;
    int v1, v2, valeur;
 
    printf("\nEntrer X1 et X2 (hexa, 00 pour arreter) : ");
    scanf(" %c %c", &X1, &X2);
 
    while (!(X1 == '0' && X2 == '0'))
    {
        v1 = (X1 >= 'A' && X1 <= 'F') ? (X1 - 'A' + 10) : (X1 - '0');
        v2 = (X2 >= 'A' && X2 <= 'F') ? (X2 - 'A' + 10) : (X2 - '0');
        valeur = v1 * 16 + v2;
        printf("\nValeur decimale = %d", valeur);
 
        printf("\nEntrer X1 et X2 (hexa, 00 pour arreter) : ");
        scanf(" %c %c", &X1, &X2);
    }
}
2. X, Y, Z en ordre croissant
#include <stdio.h>
main()
{
    int X, Y, Z, tmp;
    printf("\nEntrer X, Y, Z : ");
    scanf("%d %d %d", &X, &Y, &Z);
 
    if (X > Y) { tmp = X; X = Y; Y = tmp; }
    if (Y > Z) { tmp = Y; Y = Z; Z = tmp; }
    if (X > Y) { tmp = X; X = Y; Y = tmp; }
 
    printf("\nOrdre croissant : %d %d %d", X, Y, Z);
}
3. Divisibilité X par Y, répété tant que Y ≠ 0
#include <stdio.h>
