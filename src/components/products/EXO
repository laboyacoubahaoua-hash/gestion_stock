4. X^Y / Y! tant que Y ≠ 0
#include <stdio.h>
main()
{
    int X, Y, i;
    long puissance, factoriel;
    float resultat;
 
    printf("\nEntrer X et Y (Y = 0 pour arreter) : ");
    scanf("%d %d", &X, &Y);
 
    while (Y != 0)
    {
        puissance = 1;
        for (i = 1; i <= Y; i++)
            puissance = puissance * X;
 
        factoriel = 1;
        for (i = 1; i <= Y; i++)
            factoriel = factoriel * i;
 
        resultat = (float) puissance / factoriel;
        printf("\nX^Y / Y! = %f", resultat);
 
        printf("\nEntrer X et Y (Y = 0 pour arreter) : ");
        scanf("%d %d", &X, &Y);
    }
}
